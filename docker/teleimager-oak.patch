+    def _crop_size(self, width, height):
+        output_height, output_width = self._img_shape[:2]
+        output_aspect = output_width / output_height
+
+        crop_width = max(2, int(width * self._crop_scale))
+        crop_height = max(2, int(round(crop_width / output_aspect)))
+        if crop_height > height:
+            crop_height = height
+            crop_width = max(2, int(round(crop_height * output_aspect)))
+        return crop_width, crop_height
+
+    def _apply_crop_scale(self, bgr_numpy):
+        if bgr_numpy is None or self._crop_scale is None:
+            return bgr_numpy
+        height, width = bgr_numpy.shape[:2]
+        crop_width, crop_height = self._crop_size(width, height)
+        output_height, output_width = self._img_shape[:2]
+        crop_x = max(0, (width - crop_width) // 2)
+        crop_y = max(0, (height - crop_height) // 2)
+        cropped = bgr_numpy[crop_y:crop_y + crop_height, crop_x:crop_x + crop_width]
+        return cv2.resize(cropped, (output_width, output_height), interpolation=cv2.INTER_LINEAR)
+
