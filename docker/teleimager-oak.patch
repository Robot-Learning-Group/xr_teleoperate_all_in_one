 CONFIG_PATH = os.path.normpath(CONFIG_PATH)
+CONFIG_DIR = Path(CONFIG_PATH).parent
+
+
+def _resolve_config_relative_path(path_value):
+    path = Path(path_value)
+    if path.is_absolute():
+        return path
+    return CONFIG_DIR / path
+
+
+def _load_crop_scale(cam_cfg):
+    if cam_cfg.get("crop_scale") is not None:
+        crop_scale = float(cam_cfg["crop_scale"])
+    elif cam_cfg.get("crop_config") is not None:
+        crop_config_path = _resolve_config_relative_path(cam_cfg["crop_config"])
+        with crop_config_path.open("r", encoding="utf-8") as f:
+            crop_config = yaml.safe_load(f) or {}
+        crop_scale = float(crop_config.get("fov_scale", 1.0))
+    else:
+        return None
+
+    if not 0.5 <= crop_scale <= 1.0:
+        raise ValueError("camera crop_scale/fov_scale must be between 0.5 and 1.0")
+    return crop_scale
+
 
